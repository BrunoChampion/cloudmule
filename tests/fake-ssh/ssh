#!/usr/bin/env bash
# Fake ssh for the GPU pod tests: it never connects anywhere. Logs every remote command to $FAKE_SSH_LOG and answers
# the commands cloudmule sends to a pod as a fresh pod would: every module missing, every job ending at once.
#   FAKE_SSH_DOWN=1         every connection fails (the pod never answers SSH)
#   FAKE_SSH_FAIL=<job>     that job (its log name ends in -<job>.log) exits 1
#   FAKE_SSH_WEBGL=software cloudmule-webgl-check finds Chrome rendering in software
set -u
cmd=""; next=0
for a in "$@"; do
  if [ "$next" = 1 ]; then cmd="$a"; break; fi
  case "$a" in root@*) next=1 ;; esac
done
printf '%s\n' "$cmd" >> "${FAKE_SSH_LOG:-/dev/null}"
[ "${FAKE_SSH_DOWN:-}" = 1 ] && { echo "ssh: connect to host: Connection refused" >&2; exit 255; }
exit_of() { case "$1" in *"-${FAKE_SSH_FAIL:-no-such-job}.log"*) echo 1 ;; *) echo 0 ;; esac; }
case "$cmd" in
  cloudmule-webgl-check)         # FAKE_SSH_WEBGL=software: Chrome fell back to software rendering
    if [ "${FAKE_SSH_WEBGL:-}" = software ]; then echo "WebGL renderer: SwiftShader"; exit 1; fi
    echo "WebGL renderer: ANGLE (NVIDIA, Vulkan 1.3 (NVIDIA A40))" ;;
  *"; do test -f "*)             # ensure_modules: which modules are missing (all of them on a new pod)
    mods="${cmd#*for s in }"; mods="${mods%%; do*}"; for m in $mods; do printf ' %s' "$m"; done ;;
  *"tail -c 4000 "*)             echo "EXIT $(exit_of "$cmd")" ;;
  "cat /root/cloudmule/jobs/"*)  echo "working"
                                 case "$cmd" in *-module-*|*-install.log|*/module-*) ;;
                                   *) [ "$(exit_of "$cmd")" = 0 ] && echo "CLOUDMULE_RESULT out/frame.png" ;; esac
                                 echo "EXIT $(exit_of "$cmd")" ;;
  *".usage.prev "*)              echo "start=1000 end=1090 exit=0 peak_bytes=2147483648 cpu_usec=45000000 stall_usec=0 type= vcpus=16 mem_kb=65000000" ;;
  *"cat > "*|*"tar "*"xf"*|*"xargs "*) cat > /dev/null ;;   # uploads: swallow what is sent
esac
exit 0
