# Copy to .env and paste your token. Never commit .env, never paste the token in a chat.

# Hetzner Cloud API token, Read & Write (console.hetzner.com → your project → Security → API tokens).
HCLOUD_TOKEN=

# Normally you choose the server each time it is created (`cloudmule servers <project>` lists what fits, then
# `cloudmule start <project> --type <type>`). This list is only the fallback when no --type is given: the first
# type that fits the project and is available is used, in the cheapest location. A project can override it.
# cx53 = 16 vCPU / 32 GB ≈ 0.056 EUR/h but often unavailable; cpx62 = 16 vCPU / 32 GB ≈ 0.21 EUR/h.
# Note: a saved workspace only restores on a disk at least as large as the first server's disk.
SERVER_TYPES="cx53 cpx62"
LOCATIONS="nbg1 fsn1 hel1"

# Cost guard (runs on the server every 5 min; works even if this computer is off):
# work session: snapshot + delete after this many idle minutes, or after this many hours up
IDLE_MINUTES=45
SESSION_MAX_HOURS=8
# one-shot job: delete after this many idle minutes, or after this many hours up
ONESHOT_IDLE_MINUTES=20
ONESHOT_MAX_HOURS=3
