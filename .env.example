# Copy to .env and paste your token. Never commit .env, never paste the token in a chat.
# Any setting below can also be given for one command, and then wins: IDLE_MINUTES=10 cloudmule start …

# Hetzner Cloud API token, Read & Write (console.hetzner.com → your project → Security → API tokens).
HCLOUD_TOKEN=

# No setting chooses the server: you choose it with your agent each time it is created (`cloudmule servers
# <project>` lists what fits, the disk floor and your last choice; then `cloudmule start <project> --type <type>`).
# The choice is recorded on Hetzner, so every project and computer sees it.
# Locations allowed for the server (the cheapest available one is used, unless `start --location`).
LOCATIONS="nbg1 fsn1 hel1"

# Cost guard (runs on the server every 5 min; works even if this computer is off):
# work session: snapshot + delete after this many idle minutes, or after this many hours up
IDLE_MINUTES=45
SESSION_MAX_HOURS=8
# one-shot job: delete after this many idle minutes, or after this many hours up
ONESHOT_IDLE_MINUTES=20
ONESHOT_MAX_HOURS=3

# Local records (logs/): full job logs are deleted after LOG_KEEP_DAYS; `cloudmule usage` keeps one line per job
# (peak RAM, CPU time, duration) for USAGE_KEEP_DAYS.
LOG_KEEP_DAYS=14
USAGE_KEEP_DAYS=90
